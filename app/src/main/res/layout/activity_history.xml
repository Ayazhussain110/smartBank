
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HEADER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction History"
                android:textColor="#111827"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track all your transactions"
                android:textColor="#667085"
                android:textSize="12sp"
                android:layout_marginTop="5dp"/>


            <!-- SUMMARY CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:layout_marginTop="22dp">

                <!-- INCOME -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_quick_action">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Income"
                        android:textColor="#667085"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR 185,000"
                        android:textColor="#16A34A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="9dp"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="17sp"/>

                </LinearLayout>


                <!-- EXPENSE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_quick_action">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Expenses"
                        android:textColor="#667085"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvTotalExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR 2,650"
                        android:textColor="#DC2626"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="9dp"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="17sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- SEARCH -->

            <EditText
                android:id="@+id/etSearchTransaction"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_quick_action"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:hint="Search transactions..."
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="text"/>


            <!-- FILTER HEADING -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter Transactions"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"/>


            <!-- FILTER BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#1558E8"/>

                <TextView
                    android:id="@+id/filterIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="center"
                    android:text="Income"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:background="@drawable/bg_quick_action"/>

                <TextView
                    android:id="@+id/filterExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="center"
                    android:text="Expense"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:background="@drawable/bg_quick_action"/>

            </LinearLayout>


            <!-- TRANSACTION HEADING -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Transactions"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>


            <!-- TRANSACTION CONTAINER -->

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simulated demo transactions • No real bank connection"
                android:textColor="#98A2B3"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"/>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_nav_home"
            android:contentDescription="Home"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navCards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_nav_cards"
            android:contentDescription="Cards"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navTransfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_nav_transfer"
            android:contentDescription="Transfer"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_nav_history"
            android:contentDescription="History"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_nav_profile"
            android:contentDescription="Profile"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
