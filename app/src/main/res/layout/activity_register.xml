

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- SmartBank Logo -->
        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_logo_mark"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/sb_surface"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="SmartBank"
            android:textColor="@color/sb_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Create Account"
            android:textColor="@color/sb_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Join SmartBank and manage your money easily"
            android:textColor="@color/sb_text_secondary"
            android:textSize="13sp" />

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Full Name"
            android:textColor="@color/sb_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etFullName"
            style="@style/SmartBankInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Enter your full name"
            android:inputType="textPersonName" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Email Address"
            android:textColor="@color/sb_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegisterEmail"
            style="@style/SmartBankInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress" />

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Phone Number"
            android:textColor="@color/sb_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPhone"
            style="@style/SmartBankInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="03XX XXXXXXX"
            android:inputType="phone"
            android:maxLength="11" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Password"
            android:textColor="@color/sb_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegisterPassword"
            style="@style/SmartBankInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Create a password"
            android:inputType="textPassword" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Confirm Password"
            android:textColor="@color/sb_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            style="@style/SmartBankInputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Confirm your password"
            android:inputType="textPassword" />

        <!-- Terms Checkbox -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/sb_secondary"
            android:text="I agree to the Terms &amp; Conditions"
            android:textColor="@color/sb_text_secondary"
            android:textSize="12sp" />

        <!-- Create Account Button -->
        <Button
            android:id="@+id/btnCreateAccount"
            style="@style/SmartBankPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/sb_secondary"
            android:text="Create Account"
            android:textColor="@color/sb_surface" />

        <!-- Login Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/sb_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="@color/sb_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
