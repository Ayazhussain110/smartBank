
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_logo_mark"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/sb_surface"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Verify Your Account"
            android:textColor="@color/sb_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Enter the 6-digit verification code"
            android:textColor="@color/sb_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:hint="Enter OTP"
            android:inputType="number"
            android:letterSpacing="0.3"
            android:maxLength="6"
            android:textColor="@color/sb_text_primary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnVerifyOtp"
            style="@style/SmartBankPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/sb_secondary"
            android:text="Verify OTP"
            android:textColor="@color/sb_surface" />

        <TextView
            android:id="@+id/tvResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Didn't receive code? Resend"
            android:textColor="@color/sb_secondary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
